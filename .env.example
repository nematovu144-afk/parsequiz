MAX_UPLOAD_MB=20

# Postgres. Matches docker-compose.yml's "db" service when running via
# `docker compose up`; point at a hosted instance (Render, Supabase, ...)
# in production. Accepts a plain postgres:// / postgresql:// URL too —
# it's upgraded to the asyncpg driver automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/quiz_parser

# LLM fallback — "openai", "anthropic", "gemini", or "none"
LLM_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Leave blank to use each provider's default model.
LLM_MODEL=
